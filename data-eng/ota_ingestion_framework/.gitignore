# Required reference inputs and the maintained staging inventory.
# The repository-wide rules otherwise ignore every CSV file.
!/ingestion_points/raw/*.csv
!/transformation/dbt/staging_inventory.csv

# Public intermediate certificates used for verified TLS connections.
# API keys and service-account credentials remain excluded.
!/config/tls/GeoTrustTLSRSACAG1.pem
!/config/tls/SectigoPublicServerAuthenticationCADVR36.pem

