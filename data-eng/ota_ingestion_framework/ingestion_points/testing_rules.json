  "ke_strathmore_national_api": {
    "probe": "json_records",
    "records_path": "latestPrices",
    "validation_scope": "structure",
    "scope": "Raw record access in one latest-summary JSON response. Preserve source fields; price mapping, validation and freshness interpretation belong to the later transformation stage. Full coverage is unverified.",
    "collection": {
      "adapter": "strathmore",
      "options_url": "https://saficagriatlas.strathmore.edu/api/markets/options",
      "prices_url": "https://saficagriatlas.strathmore.edu/api/markets/commodity-comparison",
      "min_interval_seconds": 0.2,
      "scope": "Latest county quote summaries for every commodity and county advertised by the options endpoint. Includes livestock/fish labels as supplied. County summaries are not all underlying markets or historical observations. Pending requests resume across runs; source observation dates may differ.",
      "priority_commodities": [
        "Avocado",
        "Banana (Cooking)",
        "Banana (Ripening)",
        "Banana (Plantain)",
        "Tomatoes"
      ],
      "priority_counties": [
        "Nairobi",
        "Kirinyaga"
      ]
    }
  },
