{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {"builder": "DOCKERFILE", "dockerfilePath": "Dockerfile"},
  "deploy": {
    "startCommand": "python -m src.run_pipeline --workers 4 --max-seconds 300 --timeout 15",
    "restartPolicyType": "NEVER",
    "cronSchedule": "0 3 * * *"
  }
}
