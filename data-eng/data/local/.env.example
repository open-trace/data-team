# BigQuery source (for partition sync + dbt)
BQ_PROJECT=opentrace-prod-5ga4
DBT_BIGQUERY_LOCATION=europe-west3
BQ_DATASET=raw_dev
BQ_TABLE=example_table
# Optional: restrict to a partition, e.g. date partition
# BQ_PARTITION_FILTER=date = '2024-01-01'
BQ_PARTITION_LIMIT=10000

# Local DB: PostgreSQL (recommended)
LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:5433/datateam_local
LOCAL_TABLE=example_table

# Auth for BigQuery (schema sync, partition sync, dbt):
# - Local dbt: OAuth — gcloud auth application-default login (leave key unset).
# - Ingest package (landing_dev): shared SA key OUTSIDE the repo — see data-eng/ingestion/.env.example
# GOOGLE_APPLICATION_CREDENTIALS=/home/you/.config/opentrace/ingest-dev.json

# Datasets — transform SoT + *_dev layers
# landing = durable source of truth for dbt (NOT landing_dev; that is ingest-only and expires)
BQ_DATASET_LANDING=landing
# Legacy env names still used by dbt profiles; values are the real dataset ids:
BQ_DATASET_BRONZE=raw_dev
BQ_DATASET_SILVER=staging_dev
BQ_DATASET_INTERMEDIATE=intermediate_dev
BQ_DATASET_GOLD=mart_dev
# Optional clearer aliases (local sync scripts accept these too):
# BQ_DATASET_RAW_DEV=raw_dev
# BQ_DATASET_STAGING_DEV=staging_dev
# BQ_DATASET_MART_DEV=mart_dev

BQ_DATASETS_INCLUDE=dataverse,ingestion_metadata,landing,landing_copernicus,landing_dataverse,landing_geoportal_frankfurt,landing_iita,landing_ilri,mart_dev,mart_prod,raw_dev,raw_prod,staging_dev,staging_prod,intermediate_dev
BQ_DATASETS_EXCLUDE=
# DBT_TARGET=raw_dev
