GCP_PROJECT=opentrace-prod-5ga4
BQ_LOCATION=europe-west3
# Ingest sandbox only (expires). dbt transforms read from `landing`, not this dataset.
INGEST_TARGET_DATASET=landing_dev
# Required for live runs — path OUTSIDE the repo (shared ingest-dev SA key):
GOOGLE_APPLICATION_CREDENTIALS=/home/you/.config/opentrace/ingest-dev.json
# Legacy / unused — do not set for team onboarding:
# INGEST_IMPERSONATE_SA=
# Prod writes to dataset `landing`: CI only. Never set locally.
# INGEST_ALLOW_PROD=0
# Source keys (later)
# API_NINJAS_KEY=
# WFP_DATABRIDGES_CLIENT_ID=
# WFP_DATABRIDGES_CLIENT_SECRET=
# HDX_APP_IDENTIFIER=
